# User session env overrides, sourced by Omarchy's uwsm env loader.
# Changes require a full logout/login (or reboot) to take effect.

# Save screenshots here instead of $XDG_PICTURES_DIR / ~/Pictures.
export OMARCHY_SCREENSHOT_DIR="$HOME/Pictures/Screenshots"

# Render the desktop on the Intel iGPU (the monitor is plugged into the
# motherboard), leaving the NVIDIA card as a secondary GPU. The gpu-* symlinks
# point at /dev/dri/by-path so the order survives card0/card1 renumbering.
# Revert: delete this line and log out/in.
export AQ_DRM_DEVICES="$HOME/.config/hypr/gpu-intel:$HOME/.config/hypr/gpu-nvidia"
