{
  description = "Personal NixOS config — Omarchy-like desktop via nixarchy";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # Vendored Omarchy 4.x (QuickShell shell, Lua Hyprland API, themes, omarchy-* cmds).
    # Tag format: v<omarchy-version>-<packaging-release>. v4.0.3-1 matches the source
    # machine (Omarchy 4.0.3). Bump from https://github.com/olafkfreund/nixarchy/releases
    #
    # NOTE: nixarchy pins its own nixpkgs + a patched Hyprland ≥0.55 and adds the
    # nixarchy/hyprland cachix substituters. Do NOT `follows`-override its nixpkgs
    # and do NOT set programs.hyprland.package yourself — that breaks its Lua-API
    # assertion. Accept the second nixpkgs in the closure.
    nixarchy.url = "github:olafkfreund/nixarchy/v4.0.3-1";
  };

  outputs =
    { nixpkgs, home-manager, nixarchy, ... }@inputs:
    {
      nixosConfigurations.nixos = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        specialArgs = { inherit inputs; };
        modules = [
          ./hosts/nixos/configuration.nix

          nixarchy.nixosModules.nixarchy

          # App selections generated by `nixarchy-apply` from the Omarchy menu.
          # Inert stub until you pick apps on the machine.
          ./nixarchy-apps.nix

          home-manager.nixosModules.home-manager
          {
            home-manager.useGlobalPkgs = true;
            home-manager.useUserPackages = true;
            home-manager.extraSpecialArgs = { inherit inputs; };
            home-manager.users.cherry = import ./home/cherry.nix;
          }
        ];
      };
    };
}
